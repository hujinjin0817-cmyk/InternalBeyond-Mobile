+function _mianSleepDuration(start,end){
+  const a=String(start||'').split(':').map(Number),b=String(end||'').split(':').map(Number);
+  if(a.length!==2||b.length!==2||a.some(Number.isNaN)||b.some(Number.isNaN))return 0;
+  let mins=b[0]*60+b[1]-(a[0]*60+a[1]);if(mins<=0)mins+=1440;
+  return mins>0&&mins<=1440?mins:0;
+}
